# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Ambiente: local | staging | production
APP_ENV=local
# Nivel de logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Credenciales solo para el PostgreSQL local de docker-compose.yml
DATABASE_URL=postgresql://sublimaciones:sublimaciones@localhost:5433/sublimaciones
TEST_DATABASE_URL=postgresql://sublimaciones:sublimaciones@localhost:5433/sublimaciones_test

# URL pública del sitio: enlaces de los correos y origen permitido (CSRF)
APP_URL=http://localhost:3000
# Correo: "consola" (escribe los correos en el log) o "memoria" (pruebas). Solo valen en local.
EMAIL_PROVIDER=consola

# Secreto del cron externo que llama a /api/internal/jobs/* (mínimo 32 caracteres). Sin él, esos endpoints responden 404.
CRON_SECRET=

# Archivos (INC-07). "s3" usa el MinIO de docker-compose.yml en local; "memoria" es solo para las pruebas.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sublimaciones
# Credenciales solo del MinIO local (docker-compose.yml las usa también como usuario raíz).
S3_ACCESS_KEY_ID=sublimaciones
S3_SECRET_ACCESS_KEY=sublimaciones-local
# Tamaño máximo por archivo en bytes (D-08): 20 MB en local, revisar antes de producción.
FILES_MAX_BYTES=20971520
# Vigencia de las URLs firmadas de descarga, en segundos.
FILES_URL_TTL_SECONDS=300
